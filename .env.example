# Copy to .env (in this folder or its parent) and fill in. Never commit .env.

# Required: one of these. Portkey is preferred.
PORTKEY_API_KEY=your-portkey-api-key
# OPENAI_API_KEY=your-openai-api-key

# Optional: only if your Portkey key has no default provider attached,
# e.g. @openai-personal
# PORTKEY_PROVIDER=

# Optional: fixed admin token for the temple-office dashboard.
# If unset, a random token is generated at startup and printed in the backend console.
SERVE_ADMIN_TOKEN=change-me-admin-token

# Optional overrides
# SERVE_MODEL=gpt-6-luna
# SERVE_DB_PATH=backend/data/serve.db
